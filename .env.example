# MCP_AUTH_TOKEN=

# Capabilities granted after transport authentication. Keep empty for read-only
# access; grant only the capabilities the deployment actually needs.
# ADAPTIV_MCP_AUTH_CAPABILITIES=workspace.write,git.commit,git.push

# Host/origin allowlists protect against DNS rebinding and credential abuse.
# ALLOWED_HOSTS and RENDER_EXTERNAL_HOSTNAME remain supported.
# ADAPTIV_MCP_ALLOWED_HOSTS=api.example.com
# ADAPTIV_MCP_ALLOWED_ORIGINS=https://api.example.com

# Local files are denied by default. If download_user_content must read local
# files, configure one or more trusted absolute roots.
# ADAPTIV_MCP_ALLOWED_LOCAL_CONTENT_ROOTS=/srv/adaptiv-mcp/content

# -----------------------------------------------------------------------------
# GitHub authentication (set at least ONE)
# -----------------------------------------------------------------------------
# Personal Access Token (classic or fine-grained, with appropriate scopes)
GITHUB_TOKEN=
# Alternative names the server also checks:
# GITHUB_PAT=
# GH_TOKEN=
# GITHUB_OAUTH_TOKEN=

# -----------------------------------------------------------------------------
# GitHub API
# -----------------------------------------------------------------------------
# Override for GitHub Enterprise / custom GitHub API base.
# Default: https://api.github.com
GITHUB_API_BASE=https://api.github.com

# -----------------------------------------------------------------------------
# Render API authentication (set ONE if using Render endpoints/tools)
# -----------------------------------------------------------------------------
RENDER_API_KEY=
# Alternatives:
# RENDER_API_TOKEN=
# RENDER_TOKEN=

# Optional Render API base override
# Default: https://api.render.com
RENDER_API_BASE=https://api.render.com

# -----------------------------------------------------------------------------